{"y": 300, "items": {"c1": {"ar": "<span style=\"font-size:58px;line-height:1.15;-webkit-text-stroke:10px #000;text-shadow:0 0 22px rgba(0,0,0,.95),0 0 44px rgba(0,0,0,.85),0 6px 18px rgba(0,0,0,.9)\">هاي لسا <b>كبة</b>؟<br>أداة وحدة غيّرتها</span>", "en": "<span style=\"font-size:30px;-webkit-text-stroke:6px #000;text-shadow:0 0 16px rgba(0,0,0,.95),0 0 32px rgba(0,0,0,.85)\">Is this still kibbeh?</span>"}, "c2": {"ar": "<span style=\"font-size:58px;line-height:1.15;-webkit-text-stroke:10px #000;text-shadow:0 0 22px rgba(0,0,0,.95),0 0 44px rgba(0,0,0,.85),0 6px 18px rgba(0,0,0,.9)\">نفس <b>الوصفة</b>…<br>بس مش نفس الشكل</span>", "en": "<span style=\"font-size:30px;-webkit-text-stroke:6px #000;text-shadow:0 0 16px rgba(0,0,0,.95),0 0 32px rgba(0,0,0,.85)\">Same recipe. Not the same shape.</span>"}, "c3": {"ar": "<span style=\"font-size:58px;line-height:1.15;-webkit-text-stroke:10px #000;text-shadow:0 0 22px rgba(0,0,0,.95),0 0 44px rgba(0,0,0,.85),0 6px 18px rgba(0,0,0,.9)\">السر:<br><b>مكبس البطاطا</b></span>", "en": "<span style=\"font-size:30px;-webkit-text-stroke:6px #000;text-shadow:0 0 16px rgba(0,0,0,.95),0 0 32px rgba(0,0,0,.85)\">The secret: a potato ricer</span>"}, "c4": {"ar": "<span style=\"font-size:58px;line-height:1.15;-webkit-text-stroke:10px #000;text-shadow:0 0 22px rgba(0,0,0,.95),0 0 44px rgba(0,0,0,.85),0 6px 18px rgba(0,0,0,.9)\">الوصفة <b>بأول تعليق</b>.<br>احفظها</span>", "en": "<span style=\"font-size:30px;-webkit-text-stroke:6px #000;text-shadow:0 0 16px rgba(0,0,0,.95),0 0 32px rgba(0,0,0,.85)\">Recipe in the first comment. Save it.</span>"}}}